# Copy to .env  ->  cp .env.example .env   (restart `npm run dev` after editing)

# 1) Google Maps JavaScript API key  (https://console.cloud.google.com/google/maps-apis)
#    Enable: "Maps JavaScript API". Restrict the key to http://localhost:3000/* for safety.
VITE_GOOGLE_MAPS_API_KEY=

# 2) Backend URL (FastAPI + SQL database)
VITE_API_URL=http://localhost:8000

# 3) Default map centre (your city). Default = New Delhi
VITE_MAP_CENTER_LAT=28.6139
VITE_MAP_CENTER_LNG=77.2090
